# Local development only. Copy this file to .env and choose a password.
POSTGRES_DB=podo
POSTGRES_USER=podo
POSTGRES_PASSWORD=podo-local-password
DB_PORT=5432

# Auth uses one HTTPS origin for the frontend and API.
API_ORIGIN=https://localhost:8443
AUTH_SUCCESS_REDIRECT_URI=https://localhost:8443/auth/success
AUTH_FAILURE_REDIRECT_URI=https://localhost:8443/auth/error
# Generate a separate signing key per environment: openssl rand -base64 32
AUTH_CSRF_SIGNING_KEY=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# Server-only Admin Key for account withdrawal; empty disables new requests.
KAKAO_ADMIN_KEY=
KAKAO_REDIRECT_URI=https://localhost:8443/api/auth/callback/kakao

# Weather: 공공데이터포털 기상청 단기예보 인코딩 키 (없으면 날씨가 UNKNOWN)
KMA_SERVICE_KEY=

# Books: 용인시 도서관 신간도서 API 키 (원본 또는 포털 인코딩 키, 없으면 조회 미설정)
YONGIN_LIBRARY_API_KEY=
